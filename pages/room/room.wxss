.connecting {
  align-self: center;
  font-size: 28rpx;
  color: #7A5636;
  background: #FFF0C2;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

/* family member card */
.friend { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 28rpx; }
.avatar {
  width: 112rpx; height: 112rpx; flex-shrink: 0;
  border-radius: 50%; background: #FFE7A8;
  display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.avatar-img { width: 96rpx; height: 96rpx; }
.friend-text { flex: 1; display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.friend-name { font-size: 38rpx; font-weight: 700; }
.friend-time { font-size: 32rpx; color: #7A5636; }
.empty { padding: 32rpx; display: flex; flex-direction: column; gap: 8rpx; align-items: center; }
.empty-title { font-size: 40rpx; font-weight: 700; }
.empty-sub { font-size: 32rpx; color: #7A5636; }

/* the room */
.stage {
  position: relative;
  height: 460rpx;
  flex-shrink: 0;
  border-radius: 48rpx;
  background: #FFEFD2;
  border: 3rpx solid #EBD9BD;
  overflow: hidden;
}
.floor { position: absolute; left: 0; right: 0; bottom: 0; height: 116rpx; background: #F6DDB0; }
.pet-wrap { position: absolute; left: 50%; bottom: 68rpx; width: 300rpx; margin-left: -150rpx; display: flex; justify-content: center; }
.pet-wrap.bob { animation: bob 2.4s ease-in-out infinite; }
.pet-wrap.hop { animation: hop 0.7s ease-out; }
.pet { width: 300rpx; }
.bubble {
  position: absolute; top: 28rpx; left: 28rpx; max-width: 400rpx;
  background: #FFFFFF; border: 4rpx solid #3B2414; border-radius: 32rpx;
  padding: 14rpx 24rpx; font-size: 34rpx; line-height: 1.4;
  animation: pop 0.25s ease-out;
}
.pet-label {
  position: absolute; left: 28rpx; bottom: 30rpx;
  font-size: 30rpx; font-weight: 700; color: #7A5636;
  border-bottom: 3rpx dashed #C9B08A;
}
button.feed-self {
  position: absolute; right: 24rpx; bottom: 22rpx;
  width: auto !important; margin: 0 !important;
  height: 72rpx; padding: 0 28rpx !important; line-height: 72rpx;
  border-radius: 36rpx; background: #FFFFFF; border: 3rpx solid #3B2414;
  font-size: 30rpx; font-weight: 700; color: #3B2414;
}
button.feed-self::after { border: none; }

.hearts { position: absolute; left: 50%; bottom: 300rpx; width: 0; height: 0; }
.heart { position: absolute; width: 42rpx; height: 36rpx; opacity: 0; animation: rise 1.3s ease-out forwards; }
.h1 { left: -80rpx; }
.h2 { left: 10rpx; animation-delay: 0.15s; width: 56rpx; height: 48rpx; }
.h3 { left: 90rpx; animation-delay: 0.3s; }

/* stats */
.stats { display: flex; gap: 40rpx; padding: 0 8rpx; }
.stat { display: flex; align-items: center; gap: 16rpx; }
.stat-name { font-size: 32rpx; font-weight: 700; }
.segs { display: flex; gap: 6rpx; }
.seg { width: 32rpx; height: 24rpx; border-radius: 6rpx; background: #EBD9BD; }
.seg.full { background: #E9A23B; }
.seg.happy { background: #E2587A; }

/* sending */
.section { font-size: 38rpx; font-weight: 700; margin-top: 4rpx; }
.actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx; }
button.btn.act {
  height: 176rpx;
  border-radius: 40rpx;
  border: 4rpx solid #3B2414;
  font-size: 44rpx;
}
.act-icon { width: 60rpx; height: 60rpx; flex-shrink: 0; }

/* family row */
.family { display: flex; align-items: center; gap: 20rpx; margin-top: auto; }
.family-label { font-size: 32rpx; color: #7A5636; flex-shrink: 0; }
.family-scroll { flex: 1; white-space: nowrap; }
.family-row { display: flex; gap: 16rpx; align-items: center; }
.chip-friend {
  position: relative; flex-shrink: 0;
  display: flex; align-items: center; gap: 12rpx;
  height: 92rpx; padding: 0 28rpx 0 8rpx; box-sizing: border-box;
  border-radius: 46rpx; background: #FFFFFF; border: 3rpx solid #EBD9BD;
  font-size: 34rpx; font-weight: 700;
}
.chip-friend.on { border: 5rpx solid #3B2414; background: #FFF0C2; }
.chip-av { width: 72rpx; height: 72rpx; border-radius: 50%; background: #FFE7A8; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.chip-img { width: 60rpx; height: 60rpx; }
.dot { position: absolute; left: 58rpx; top: 8rpx; width: 20rpx; height: 20rpx; border-radius: 50%; background: #2E9D5B; border: 3rpx solid #FFFFFF; }
.chip-add {
  flex-shrink: 0; height: 92rpx; padding: 0 32rpx; box-sizing: border-box;
  display: flex; align-items: center;
  border-radius: 46rpx; border: 4rpx dashed #B8955F;
  font-size: 34rpx; font-weight: 700;
}

/* after sending */
.scene {
  position: relative; height: 320rpx; border-radius: 44rpx; overflow: hidden;
  background: #FFEFD2; display: flex; align-items: flex-end; justify-content: center;
}
.scene.night { background: #2F3459; }
.scene-floor { position: absolute; left: 0; right: 0; bottom: 0; height: 72rpx; background: #F6DDB0; }
.scene.night .scene-floor { background: #464C7A; }
.scene-tag {
  position: absolute; left: 28rpx; top: 28rpx;
  font-size: 30rpx; font-weight: 700; padding: 8rpx 20rpx; border-radius: 999rpx;
  background: #FFFFFF; color: #3B2414;
}
.scene.night .scene-tag { background: #464C7A; color: #FFFFFF; }
.zzz { position: absolute; right: 120rpx; top: 96rpx; font-size: 44rpx; font-weight: 900; color: #FFF1C4; letter-spacing: 8rpx; }
.scene-pet { position: relative; width: 300rpx; margin-bottom: 44rpx; }
.log { padding: 8rpx 28rpx; display: flex; flex-direction: column; }
.log-row { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 0; border-bottom: 2rpx solid #F1E4CF; }
.log-row:last-child { border-bottom: none; }
.log-text { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.log-what { font-size: 34rpx; font-weight: 700; }
.log-when { font-size: 28rpx; color: #7A5636; }

/* visits */
.visit-mask { justify-content: center; padding: 0 32rpx; }
.visit {
  background: #FFF6E6; border-radius: 56rpx; padding: 32rpx;
  display: flex; flex-direction: column; gap: 20rpx;
  animation: pop 0.3s ease-out;
}
.banner {
  display: flex; flex-direction: column; gap: 6rpx;
  padding: 24rpx 28rpx; border-radius: 40rpx; background: #FFD45A; border: 5rpx solid #3B2414;
}
.banner-title { font-size: 44rpx; font-weight: 900; line-height: 1.3; }
.banner-sub { font-size: 32rpx; font-weight: 500; }
.visit-stage { height: 480rpx; }
.visitor-wrap { position: absolute; left: 24rpx; bottom: 64rpx; animation: walk-in 1.1s ease-out; }
.visitor { width: 300rpx; }
.host { position: absolute; right: 36rpx; bottom: 64rpx; width: 230rpx; }
.visit-hearts { left: 52%; bottom: 280rpx; }
.visit-bubble { max-width: 380rpx; }

/* add family */
.code-box {
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  padding: 24rpx; border-radius: 32rpx; background: #FFFFFF; border: 3rpx solid #EBD9BD;
}
.code-label { font-size: 30rpx; color: #7A5636; }
.code { font-size: 72rpx; font-weight: 900; letter-spacing: 6rpx; }
.or { align-self: center; font-size: 30rpx; color: #7A5636; }
