+function queueAction(code, entry) {
+  const now = Date.now();
+  const list = (pendingActions.get(code) || []).filter((e) => now - e.at < PENDING_TTL_MS);
+  list.push(entry);
+  pendingActions.set(code, list.slice(-MAX_PENDING_PER_ROOM));
+}
+
+/** Tell a sender their action reached the other person: now if they're connected, else on their next hello. */
+function sendReceipt(deviceId, msg) {
+  if (!deviceId) return;
+  if (notifyDevice(deviceId, msg) > 0) return;
+  const list = pendingReceipts.get(deviceId) || [];
+  list.push(msg);
+  pendingReceipts.set(deviceId, list.slice(-50));
+}
+
+function flushReceipts(deviceId, ws) {
+  const list = deviceId && pendingReceipts.get(deviceId);
+  if (!list || !list.length) return;
+  pendingReceipts.delete(deviceId);
+  for (const msg of list) send(ws, msg);
+}
+
+/**
+ * Someone just attached: replay what the other person sent while they were away (the newest few, each
+ * marked `queued` with its original time; `missed` is the full count) and receipt every one of them.
+ * Older apps ignore the extra fields and simply play the visits.
+ */
+function flushPendingActions(room, ws, deviceId) {
+  const list = pendingActions.get(room.code);
+  if (!list || !list.length) return;
+  const now = Date.now();
+  const fresh = list.filter((e) => now - e.at < PENDING_TTL_MS);
+  const forMe = fresh.filter((e) => !deviceId || e.senderDeviceId !== deviceId);
+  const stillWaiting = fresh.filter((e) => deviceId && e.senderDeviceId === deviceId);
+  if (stillWaiting.length) pendingActions.set(room.code, stillWaiting);
+  else pendingActions.delete(room.code);
+  if (!forMe.length) return;
+  for (const e of forMe.slice(-MAX_REPLAY_ON_ATTACH)) {
+    const st = memberStats(room, e.from);
+    send(ws, {
+      type: "sync",
+      code: room.code,
+      fullness: st?.fullness ?? 80,
+      happiness: st?.happiness ?? 80,
+      updatedAt: e.at,
+      action: e.action,
+      from: e.from,
+      species: e.species,
+      outfit: e.outfit || "",
+      dnd: false,
+      queued: true,
+      at: e.at,
+      missed: forMe.length,
+    });
+  }
+  for (const e of forMe) {
+    if (e.id) sendReceipt(e.senderDeviceId, { type: "ack", code: room.code, id: e.id, status: "delivered", at: now });
+  }
+}
